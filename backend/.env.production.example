# Production backend environment — set these in your HOST's dashboard.
# Do NOT commit real values. This file is only a template.

# MongoDB Atlas connection string (Atlas → Connect → Drivers → Python):
MONGO_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=omega"
DB_NAME="omega_kitchen"

# Generate a long random secret, e.g. on Windows PowerShell:
#   [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
JWT_SECRET="REPLACE-WITH-A-LONG-RANDOM-SECRET"

# Seeded admin account — use a STRONG password (the current dev one is public in git history):
ADMIN_EMAIL="admin@omegaskitchen.com"
ADMIN_PASSWORD="REPLACE-WITH-A-STRONG-ADMIN-PASSWORD"

# Only needed for Gmail password-reset emails (Phase 2).
# Create at: Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER="youraddress@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"
